#!/bin/sh
# Hyperspace Engine MCP launcher.
#
# Resolves the project root, requires the isolated env's interpreter to
# exist, and execs it against `hyperspace.mcp`. Never a bare `python3` —
# that would miss the isolated environment the setup skill provisions.
set -eu

ROOT="${CLAUDE_PROJECT_DIR:-$PWD}"
PYTHON="$ROOT/.hyperspace/env/bin/python"

if [ ! -x "$PYTHON" ]; then
    echo "hyperspace-mcp: missing $ROOT/.hyperspace/env — run the hyperspace-setup skill, or: hyperspace init" >&2
    exit 1
fi

exec "$ROOT/.hyperspace/env/bin/python" -m hyperspace.mcp "$@"
